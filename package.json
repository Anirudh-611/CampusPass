{
  "name": "campuspass",
  "version": "1.0.0",
  "private": true,
  "description": "CampusPass Smart Digital Campus Identity & Verification Platform",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
